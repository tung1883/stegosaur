{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Stegosaur",
  "version": "0.1.0",
  "identifier": "app.stegosaur.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Stegosaur",
        "decorations": false,
        "transparent": true,
        "maximizable": false,
        "shadow": false,
        "center": true,
        "width": 1000,
        "height": 720,
        "minWidth": 1000,
        "minHeight": 720
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ]
  }
}
